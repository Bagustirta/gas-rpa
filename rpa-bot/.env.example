# URL aplikasi Laravel Anda (contoh: http://gas.test atau http://localhost:8000)
LARAVEL_APP_URL=http://localhost:8000

# API Key keamanan dari file .env Laravel (LPG_API_KEY)
LPG_API_KEY=lpg-secret-token-12345

# URL Portal MAP Pertamina
PERTAMINA_PORTAL_URL=https://subsiditepatlpg.mypertamina.id/

# Konfigurasi Selectors (Ganti jika elemen website Pertamina berubah)
SELECTOR_NIK_INPUT=#nik-input-id
SELECTOR_CARI_BUTTON=#btn-cari-id
SELECTOR_QTY_INPUT=#qty-input-id
SELECTOR_SIMPAN_BUTTON=#btn-simpan-id

# =============================================================
# Telegram Alert & AI Self-Healing Watchdog (watchdog.js)
# =============================================================
# Token bot Telegram — dapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chat ID penerima notifikasi — dapatkan dari @userinfobot di Telegram
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Google Gemini API Key untuk analisis bug otomatis
# Dapatkan gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
